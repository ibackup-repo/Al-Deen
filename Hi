// Apply only to TS/TSX source files (excludes node_modules, build outputs, and JSON)
filter "**/{src,app}/**/*.{ts,tsx}"

replace-regex "\bquran_font\b"
with "Quran_Font"

replace-regex "\buthmani_v1\b"
with "Uthmani_V1"

replace-regex "\buthmani_v2\b"
with "Uthmani_V2"

replace-regex "\buthmani_v4\b"
with "Uthmani_V4"

replace-regex "\bsurah_id\b"
with "Surah_Identifier"

replace-regex "\bsurahId\b"
with "Surah_Identifier"

replace-regex "\bayah_num\b"
with "Ayah_Number"

replace-regex "\bformattedReciter\b"
with "Formatted_Reciter"

replace-regex "\bhoverRecitation\b"
with "Hover_Recitation"

replace-regex "\bselectedReciter\b"
with "Selected_Reciter"

replace-regex "\bactiveKey\b"
with "Active_Key"

replace-regex "\bsetActiveKey\b"
with "Set_Active_Key"

replace-regex "\baudioRef\b"
with "Audio_Reference"

replace-regex "\bstopAudio\b"
with "Stop_Current_Audio"

replace-regex "\bplaySegment\b"
with "Play_Segment"

replace-regex "\btooltipContent\b"
with "Tooltip_Content"

replace-regex "\bstartMs\b"
with "Start_Milliseconds"

replace-regex "\bendMs\b"
with "End_Milliseconds"

replace-regex "\bhandleTimeUpdate\b"
with "Handle_Time_Update"

replace-regex "\bplayAyah\b"
with "Play_Ayah_Audio"

replace-regex "\baudioUrl\b"
with "Audio_Url"

replace-regex "\bfullUrl\b"
with "Full_Url"

replace-regex "\bplayWord\b"
with "Play_Word_Audio"

replace-regex "\bwordIndex\b"
with "Word_Index"

replace-regex "\bwordSegment\b"
with "Word_Segment"

replace-regex "\bisPlaying\b"
with "Is_Playing"

replace-regex "\bextractAyahNumFromMarker\b"
with "Extract_Ayah_Number_From_Marker"